{
  "name": "GFX.Assets",
  "version": "0.2.0",
  "description": "Portable image, model, and sprite-sheet data with runtime asset stores.",
  "authors": ["Matanek"],
  "requires": { "silex": ">=0.39.0" },
  "dependencies": {
    "GFX": "^0.37.0",
    "JSON": "^0.1.0",
    "STD": "^0.16.0"
  },
  "boundary": {
    "macos-arm64": {
      "providers": {
        "SDL3": { "requires": ["GFX.SDL3"] }
      }
    },
    "linux-x64": {
      "providers": {
        "SDL3": { "requires": ["GFX.SDL3"] }
      }
    },
    "windows-x64": {
      "providers": {
        "SDL3": { "requires": ["GFX.SDL3"] }
      }
    },
    "windows-arm64": {
      "providers": {
        "SDL3": { "requires": ["GFX.SDL3"] }
      }
    }
  }
}
