use GFX.Assets.Image

public struct Clip {
    private let clip_name:str
    private let clip_frames:Image.Region[]
    private let frames_per_second:float

    module init(name:str, frames:Image.Region[], fps:float) {
        self.clip_name = name
        self.clip_frames = frames
        self.frames_per_second = fps
    }

    func name() str { return self.clip_name }
    func frame_count() int { return self.clip_frames.count() }
    func fps() float { return self.frames_per_second }
    func frame(index:int) Image.Region { return self.clip_frames[index] }
}

public struct SpriteSheet {
    private let sheet_image:Image.Handle
    private let frame_width_pixels:int
    private let frame_height_pixels:int
    private var clips:Clip[]

    module init() {
        self.sheet_image = Image.Handle()
        self.frame_width_pixels = 1
        self.frame_height_pixels = 1
        self.clips = []
    }

    init(image:Image.Handle, frame_width:int, frame_height:int) {
        if !image.is_valid() { panic("GFX sprite sheet requires a valid image") }
        if frame_width <= 0 || frame_height <= 0 {
            panic("GFX sprite sheet frame dimensions must be positive")
        }
        self.sheet_image = image
        self.frame_width_pixels = frame_width
        self.frame_height_pixels = frame_height
        self.clips = []
    }

    func clip(
        name:str,
        row:int,
        frames:int,
        fps:float,
        column:int = 0
    ) {
        if name == "" { panic("GFX sprite animation name cannot be empty") }
        if row < 0 || column < 0 || frames <= 0 {
            panic("GFX sprite animation requires a non-negative row and column and at least one frame")
        }
        if fps <= 0.0 { panic("GFX sprite animation requires a positive frame rate") }
        for existing in self.clips {
            if existing.name() == name { panic("GFX sprite animation names must be unique") }
        }
        var regions:Image.Region[] = []
        var index = 0
        while index < frames {
            regions.append(Image.Region(
                x:(column + index) * self.frame_width_pixels,
                y:row * self.frame_height_pixels,
                width:self.frame_width_pixels,
                height:self.frame_height_pixels
            ))
            index++
        }
        self.clips.append(Clip(name, regions, fps))
    }

    func image() Image.Handle { return self.sheet_image }
    func has_clip(name:str) bool {
        for clip in self.clips { if clip.name() == name { return true } }
        return false
    }

    func clip(name:str) Clip {
        for clip in self.clips { if clip.name() == name { return clip } }
        panic("GFX sprite sheet does not contain animation '" + name + "'")
    }

    module func is_empty() bool { return self.clips.count() == 0 }
}

public struct Handle {
    module let asset_index:int
    module let asset_generation:int

    init() {
        self.asset_index = -1
        self.asset_generation = 0
    }

    module init(index:int, generation:int) {
        self.asset_index = index
        self.asset_generation = generation
    }

    func is_valid() bool {
        return self.asset_index >= 0 && self.asset_generation > 0
    }
}

class Entry {
    let sheet:SpriteSheet
    var generation:int
    var active:bool

    init(sheet:SpriteSheet) {
        self.sheet = sheet
        self.generation = 1
        self.active = true
    }
}

public class Store {
    private var entries:Entry[]

    init() { self.entries = [] }

    func add(sheet:SpriteSheet) Handle {
        if sheet.is_empty() { panic("GFX cannot add a sprite sheet without animations") }
        var entries = self.entries
        entries.append(Entry(sheet))
        self.entries = entries
        return Handle(entries.count() - 1, 1)
    }

    func contains(handle:Handle) bool {
        if !handle.is_valid() || handle.asset_index >= self.entries.count() { return false }
        var entry = self.entries[handle.asset_index]
        return entry.active && entry.generation == handle.asset_generation
    }

    func get(handle:Handle) @SpriteSheet {
        self.require(handle)
        return self.entries[handle.asset_index].sheet
    }

    func remove(handle:Handle) bool {
        if !self.contains(handle) { return false }
        var entry = self.entries[handle.asset_index]
        entry.active = false
        entry.generation++
        return true
    }

    private func require(handle:Handle) Entry {
        if !self.contains(handle) { panic("GFX sprite sheet handle is stale or invalid") }
        return self.entries[handle.asset_index]
    }
}
