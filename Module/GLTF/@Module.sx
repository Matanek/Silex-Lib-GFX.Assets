use GFX.Assets.Model
use STD.Error as STDError
use STD.File
use STD.Path.Path as Path
use STD.Text.UTF8

public use GFX.Assets.GLTF.Types.ErrorKind
public use GFX.Assets.GLTF.Types.Error
public use GFX.Assets.GLTF.Types.Format

public func decode(bytes:uint8[], format:Format = Format.glb) Result<Model, Error> {
    return match format {
        glb => (try GFX.Assets.GLTF.Reader.decode_glb(bytes, null))
        gltf => (try GFX.Assets.GLTF.Reader.decode_gltf(bytes, null))
    }
}


public func encode(model:Model, format:Format = Format.glb) Result<uint8[], Error> {
    return (try GFX.Assets.GLTF.Writer.encode(model, format))
}


public func load(path:Path) Result<Model, Error> {
    var bytes:uint8[] = []
    match (try File.read_all(path, 256 * 1024 * 1024)) {
        failure(error) => { return Result<Model, Error>.failure(file_error(path, error)) }
        success(value) => { bytes = value }
    }
    if ends_with_case_insensitive(path, ".glb") {
        return (try GFX.Assets.GLTF.Reader.decode_glb(bytes, path))
    }
    if ends_with_case_insensitive(path, ".gltf") {
        return (try GFX.Assets.GLTF.Reader.decode_gltf(bytes, path))
    }
    return Result<Model, Error>.failure(Error(
        kind:ErrorKind.unsupported_feature,
        subject:path,
        detail:"GFX.Assets.GLTF supports .gltf and .glb model assets"
    ))
}


public func save(path:Path, model:Model) Result<void, Error> {
    var format = Format.glb
    if ends_with_case_insensitive(path, ".gltf") { format = Format.gltf }
    elif !ends_with_case_insensitive(path, ".glb") {
        return Result<void, Error>.failure(Error(
            kind:ErrorKind.unsupported_feature,
            subject:path,
            detail:"GFX.Assets.GLTF supports .gltf and .glb model assets"
        ))
    }
    let bytes = try encode(model, format) else error { return Result<void,Error>.failure(error) }
    if bytes.count() == 0 {
        return Result<void, Error>.failure(Error(
            kind:ErrorKind.invalid_document,
            subject:path,
            detail:"GLTF encoder produced an empty document"
        ))
    }
    match (try File.write_all(path, @bytes[0:bytes.count()])) {
        failure(error) => { return Result<void, Error>.failure(file_error(path, error)) }
        success => { return Result<void, Error>.success() }
    }
}


func file_error(path:Path, error:STDError) Error {
    return Error(kind:ErrorKind.file, subject:path, detail:error.detail)
}

func display(error:Error) str {
    if let subject = error.subject { return subject + ": " + error.detail }
    return error.detail
}

func ends_with_case_insensitive(value:str, suffix:str) bool {
    let value_bytes = UTF8.bytes(value)
    let suffix_bytes = UTF8.bytes(suffix)
    if value_bytes.count() < suffix_bytes.count() { return false }
    let offset = value_bytes.count() - suffix_bytes.count()
    var index = 0
    while index < suffix_bytes.count() {
        var left = value_bytes[offset + index]
        var right = suffix_bytes[index]
        if left >= 65 && left <= 90 { left += 32 }
        if right >= 65 && right <= 90 { right += 32 }
        if left != right { return false }
        index++
    }
    return true
}
