use GFX.Color
use Interop.C
use STD.Math

public struct Image {
    private let image_width:int
    private let image_height:int
    private let image_pixels:uint8[]
    private let packed:str

    init() {
        self.image_width = 1
        self.image_height = 1
        let pixels:uint8[] = [255, 255, 255, 255]
        self.image_pixels = pixels
        self.packed = C.string(@pixels[0:pixels.count()])
    }

    init(width:int, height:int, rgba:uint8[]) {
        require_dimensions(width, height, rgba.count())
        self.image_width = width
        self.image_height = height
        self.image_pixels = rgba
        self.packed = C.string(@rgba[0:rgba.count()])
    }

    private init(width:int, height:int, rgba:str) {
        if width <= 0 || height <= 0 || C.byte_count(rgba) < (width * height * 4) as uint {
            panic("GFX.Assets image requires one RGBA8 texel per pixel")
        }
        self.image_width = width
        self.image_height = height
        self.image_pixels = []
        self.packed = move rgba
    }

    static func rgba8(width:int, height:int, pixels:uint8[]) Image {
        return Image(width, height, pixels)
    }

    static func packed_rgba8(width:int, height:int, pixels:str) Image {
        return Image(width, height, pixels)
    }

    static func solid(color:Color = Color.white()) Image {
        let pixels:uint8[] = [
            channel(color.r),
            channel(color.g),
            channel(color.b),
            channel(color.a)
        ]
        return Image(1, 1, pixels)
    }

    func width() int { return self.image_width }
    func height() int { return self.image_height }
    func byte_count() int { return self.image_width * self.image_height * 4 }
    func packed_pixels() str { return self.packed }

    func pixels() uint8[] {
        if self.image_pixels.count() != 0 { return self.image_pixels }
        var result:uint8[] = []
        var index:uint = 0
        while index < self.byte_count() as uint {
            result.append(C.byte_at(self.packed, index))
            index++
        }
        return result
    }
}

func require_dimensions(width:int, height:int, byte_count:int) {
    if width <= 0 || height <= 0 || byte_count != width * height * 4 {
        panic("GFX.Assets image requires one RGBA8 texel per pixel")
    }
}

func channel(value:float) uint8 {
    return Math.round(Math.clamp(value, 0.0, 1.0) * 255.0) as uint8
}

public struct Region {
    let x:int
    let y:int
    let width:int
    let height:int

    init(x:int, y:int, width:int, height:int) {
        if x < 0 || y < 0 || width <= 0 || height <= 0 {
            panic("GFX image region requires a non-negative origin and positive dimensions")
        }
        self.x = x
        self.y = y
        self.width = width
        self.height = height
    }
}

public struct Handle {
    module let asset_index:int
    module let asset_generation:int

    init() {
        self.asset_index = -1
        self.asset_generation = 0
    }

    module init(index:int, generation:int) {
        self.asset_index = index
        self.asset_generation = generation
    }

    func is_valid() bool {
        return self.asset_index >= 0 && self.asset_generation > 0
    }

    func index() int { return self.asset_index }
    func generation() int { return self.asset_generation }
}

class Entry {
    var image:Image
    var generation:int
    var revision:int
    var active:bool

    init(image:Image) {
        self.image = image
        self.generation = 1
        self.revision = 1
        self.active = true
    }
}

public class Store {
    private var entries:Entry[]

    init() { self.entries = [] }

    func add(image:Image) Handle {
        self.entries.append(Entry(image))
        return Handle(self.entries.count() - 1, 1)
    }

    func contains(handle:Handle) bool {
        if !handle.is_valid() || handle.asset_index >= self.entries.count() { return false }
        var entry = self.entries[handle.asset_index]
        return entry.active && entry.generation == handle.asset_generation
    }

    func get(handle:Handle) @Image {
        self.require(handle)
        return self.entries[handle.asset_index].image
    }

    func snapshot(handle:Handle) Image {
        self.require(handle)
        return self.entries[handle.asset_index].image
    }

    func replace(handle:Handle, image:Image) {
        var entry = self.require(handle)
        entry.image = image
        entry.revision++
    }

    func remove(handle:Handle) bool {
        if !self.contains(handle) { return false }
        var entry = self.entries[handle.asset_index]
        entry.active = false
        entry.generation++
        entry.revision++
        return true
    }

    func revision(handle:Handle) int {
        if !self.contains(handle) { return 0 }
        return self.entries[handle.asset_index].revision
    }

    private func require(handle:Handle) Entry {
        if !self.contains(handle) { panic("GFX.Assets image handle is stale or invalid") }
        return self.entries[handle.asset_index]
    }
}
